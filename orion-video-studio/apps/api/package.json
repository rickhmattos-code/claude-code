{
  "name": "@orion/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "openapi": "node --env-file-if-exists=../../.env --import tsx src/print-openapi.ts > ../../docs/openapi.json.tmp && mv ../../docs/openapi.json.tmp ../../docs/openapi.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@orion/db": "*",
    "@orion/providers": "*",
    "@orion/server": "*",
    "@orion/shared": "*",
    "@orion/timeline": "*",
    "fastify": "5.12.5",
    "zod": "4.6.5",
    "ioredis": "5.11.1"
  }
}
