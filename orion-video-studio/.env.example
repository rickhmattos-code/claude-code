# ---------------------------------------------------------------------------
# ORION VIDEO STUDIO — variáveis de ambiente (copie para .env)
# Nunca coloque valores reais neste arquivo. Chaves de provedores ficam
# SOMENTE no servidor (api/worker); o frontend nunca as recebe.
# ---------------------------------------------------------------------------

# Banco e fila
DATABASE_URL=postgresql://orion:orion@localhost:5432/orion
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Segredo para assinar URLs temporárias do driver local (>= 32 caracteres)
URL_SIGNING_SECRET=change-me-to-a-long-random-string-0123456789

# Armazenamento: "local" (disco, URLs assinadas pela API) ou "s3" (MinIO/AWS/R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
S3_ENDPOINT=http://localhost:9000
# endpoint usado nas URLs assinadas entregues ao navegador (em Docker: http://localhost:9000)
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=orion-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Worker
WORKER_TMP_DIR=./.data/tmp
WORKER_CONCURRENCY_RENDER=1
WORKER_CONCURRENCY_MEDIA=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Limites operacionais (em segundos / bytes)
MAX_PROJECT_SECONDS=1800
MAX_UPLOAD_BYTES=4294967296
DEFAULT_WORKSPACE_QUOTA_BYTES=21474836480
RENDER_TIMEOUT_SECONDS=7200

# Limite mensal de gasto com IA por workspace (centavos de USD)
DEFAULT_GENERATION_BUDGET_CENTS=2000

# ---------------------------------------------------------------------------
# Provedores (opcionais). Sem chave => integração aparece como
# "configuração pendente" e nenhuma chamada é feita.
# ---------------------------------------------------------------------------
# Google Gemini API (Veo — vídeo; Imagen — imagem)
GEMINI_API_KEY=
# ElevenLabs (texto para fala com timestamps)
ELEVENLABS_API_KEY=
# OpenAI (transcrição whisper-1; TTS alternativo)
OPENAI_API_KEY=
# Anthropic (roteiro / assistente)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Somente para testes automatizados: ativa provedores simulados,
# sempre exibidos na interface como "MODO DE TESTE".
PROVIDERS_MOCK=0
