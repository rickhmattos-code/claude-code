{
  "name": "orion-video-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @orion/api",
    "dev:worker": "npm run dev -w @orion/worker",
    "dev:web": "npm run dev -w @orion/web",
    "db:generate": "npm run generate -w @orion/db",
    "db:migrate": "npm run migrate:deploy -w @orion/db",
    "db:seed": "npm run seed -w @orion/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node --experimental-strip-types scripts/make-fixtures.ts",
    "openapi": "npm run openapi -w @orion/api"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "25.9.9",
    "s3rver": "^3.7.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
